---
import type { ChromaticHoverOptions } from './core'

type Props = Omit<ChromaticHoverOptions, 'root'> & { as?: string; class?: string }
const { as: Tag = 'div', class: className, ...options } = Astro.props
---

<Tag class={className} data-jawdrop="chromatic-hover" data-options={JSON.stringify(options)}><slot /></Tag>

<script>
  import { chromaticHover } from './core'

  for (const el of document.querySelectorAll<HTMLElement>('[data-jawdrop="chromatic-hover"]')) {
    chromaticHover(el, JSON.parse(el.dataset.options ?? '{}'))
  }
</script>
