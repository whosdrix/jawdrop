---
import type { AuroraOptions } from './core'

type Props = Omit<AuroraOptions, 'root'> & { as?: string; class?: string }
const { as: Tag = 'div', class: className, ...options } = Astro.props
---

<Tag class={className} data-jawdrop="aurora" data-options={JSON.stringify(options)}><slot /></Tag>

<script>
  import { aurora } from './core'

  for (const el of document.querySelectorAll<HTMLElement>('[data-jawdrop="aurora"]')) {
    aurora(el, JSON.parse(el.dataset.options ?? '{}'))
  }
</script>
