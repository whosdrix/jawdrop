---
import type { ParallaxOptions } from './core'

type Props = Omit<ParallaxOptions, 'root'> & { as?: string; class?: string }
const { as: Tag = 'div', class: className, ...options } = Astro.props
---

<Tag class={className} data-jawdrop="parallax" data-options={JSON.stringify(options)}><slot /></Tag>

<script>
  import { parallax } from './core'

  for (const el of document.querySelectorAll<HTMLElement>('[data-jawdrop="parallax"]')) {
    parallax(el, JSON.parse(el.dataset.options ?? '{}'))
  }
</script>
