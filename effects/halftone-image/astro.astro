---
import type { HalftoneImageOptions } from './core'

type Props = Omit<HalftoneImageOptions, 'root'> & { as?: string; class?: string }
const { as: Tag = 'div', class: className, ...options } = Astro.props
---

<Tag class={className} data-jawdrop="halftone-image" data-options={JSON.stringify(options)}><slot /></Tag>

<script>
  import { halftoneImage } from './core'

  for (const el of document.querySelectorAll<HTMLElement>('[data-jawdrop="halftone-image"]')) {
    halftoneImage(el, JSON.parse(el.dataset.options ?? '{}'))
  }
</script>
