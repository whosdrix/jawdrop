---
import type { MarqueeOptions } from './core'

type Props = Omit<MarqueeOptions, 'root'> & { as?: string; class?: string }
const { as: Tag = 'div', class: className, ...options } = Astro.props
---

<Tag class={className} data-jawdrop="marquee" data-options={JSON.stringify(options)}><slot /></Tag>

<script>
  import { marquee } from './core'

  for (const el of document.querySelectorAll<HTMLElement>('[data-jawdrop="marquee"]')) {
    marquee(el, JSON.parse(el.dataset.options ?? '{}'))
  }
</script>
