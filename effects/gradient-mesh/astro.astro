---
import type { GradientMeshOptions } from './core'

type Props = Omit<GradientMeshOptions, 'root'> & { as?: string; class?: string }
const { as: Tag = 'div', class: className, ...options } = Astro.props
---

<Tag class={className} data-jawdrop="gradient-mesh" data-options={JSON.stringify(options)}><slot /></Tag>

<script>
  import { gradientMesh } from './core'

  for (const el of document.querySelectorAll<HTMLElement>('[data-jawdrop="gradient-mesh"]')) {
    gradientMesh(el, JSON.parse(el.dataset.options ?? '{}'))
  }
</script>
