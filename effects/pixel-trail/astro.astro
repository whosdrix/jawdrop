---
import type { PixelTrailOptions } from './core'

type Props = Omit<PixelTrailOptions, 'root'> & { as?: string; class?: string }
const { as: Tag = 'div', class: className, ...options } = Astro.props
---

<Tag class={className} data-jawdrop="pixel-trail" data-options={JSON.stringify(options)}><slot /></Tag>

<script>
  import { pixelTrail } from './core'

  for (const el of document.querySelectorAll<HTMLElement>('[data-jawdrop="pixel-trail"]')) {
    pixelTrail(el, JSON.parse(el.dataset.options ?? '{}'))
  }
</script>
