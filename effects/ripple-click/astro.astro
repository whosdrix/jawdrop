---
import type { RippleClickOptions } from './core'

type Props = Omit<RippleClickOptions, 'root'> & { as?: string; class?: string }
const { as: Tag = 'div', class: className, ...options } = Astro.props
---

<Tag class={className} data-jawdrop="ripple-click" data-options={JSON.stringify(options)}><slot /></Tag>

<script>
  import { rippleClick } from './core'

  for (const el of document.querySelectorAll<HTMLElement>('[data-jawdrop="ripple-click"]')) {
    rippleClick(el, JSON.parse(el.dataset.options ?? '{}'))
  }
</script>
