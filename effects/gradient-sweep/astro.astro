---
import type { GradientSweepOptions } from './core'

type Props = Omit<GradientSweepOptions, 'root'> & { as?: string; class?: string }
const { as: Tag = 'span', class: className, ...options } = Astro.props
---

<Tag class={className} data-jawdrop="gradient-sweep" data-options={JSON.stringify(options)}><slot /></Tag>

<script>
  import { gradientSweep } from './core'

  for (const el of document.querySelectorAll<HTMLElement>('[data-jawdrop="gradient-sweep"]')) {
    gradientSweep(el, JSON.parse(el.dataset.options ?? '{}'))
  }
</script>
