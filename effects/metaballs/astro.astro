---
import type { MetaballsOptions } from './core'

type Props = Omit<MetaballsOptions, 'root'> & { as?: string; class?: string }
const { as: Tag = 'div', class: className, ...options } = Astro.props
---

<Tag class={className} data-jawdrop="metaballs" data-options={JSON.stringify(options)}><slot /></Tag>

<script>
  import { metaballs } from './core'

  for (const el of document.querySelectorAll<HTMLElement>('[data-jawdrop="metaballs"]')) {
    metaballs(el, JSON.parse(el.dataset.options ?? '{}'))
  }
</script>
