{
  "name": "Zoom through text",
  "category": "scroll",
  "description": "Giant letters are cut out of a solid wall, and scrolling zooms into one of them until you fly through it into the section behind.",
  "export": "zoomThrough",
  "component": "ZoomThrough",
  "budget": 3072,
  "options": {
    "distance": {
      "type": "number",
      "default": 2,
      "min": 0.5,
      "max": 5,
      "step": 0.25,
      "label": "Distance"
    },
    "fit": {
      "type": "number",
      "default": 0.84,
      "min": 0.3,
      "max": 1,
      "step": 0.02,
      "label": "Text width"
    },
    "focus": {
      "type": "number",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "step": 0.02,
      "label": "Fly through at"
    },
    "color": {
      "type": "color",
      "default": "#08090c",
      "label": "Wall color"
    }
  }
}
