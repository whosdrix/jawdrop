---
import type { ZoomThroughOptions } from './core'

type Props = Omit<ZoomThroughOptions, 'root'> & { as?: string; class?: string }
const { as: Tag = 'div', class: className, ...options } = Astro.props
---

<Tag class={className} data-jawdrop="zoom-through" data-options={JSON.stringify(options)}><slot /></Tag>

<script>
  import { zoomThrough } from './core'

  for (const el of document.querySelectorAll<HTMLElement>('[data-jawdrop="zoom-through"]')) {
    zoomThrough(el, JSON.parse(el.dataset.options ?? '{}'))
  }
</script>
