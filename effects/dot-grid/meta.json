{
  "name": "Reactive dot grid",
  "category": "backgrounds",
  "description": "A grid of dots that swell, glow and spring away from the cursor.",
  "export": "dotGrid",
  "component": "DotGrid",
  "budget": 2048,
  "options": {
    "gap": {
      "type": "number",
      "default": 28,
      "min": 12,
      "max": 64,
      "step": 1,
      "label": "Gap"
    },
    "size": {
      "type": "number",
      "default": 1.6,
      "min": 0.5,
      "max": 4,
      "step": 0.1,
      "label": "Dot size"
    },
    "radius": {
      "type": "number",
      "default": 140,
      "min": 40,
      "max": 400,
      "step": 10,
      "label": "Reach"
    },
    "strength": {
      "type": "number",
      "default": 18,
      "min": 0,
      "max": 60,
      "step": 1,
      "label": "Push"
    },
    "color": {
      "type": "color",
      "default": "#3a4466",
      "label": "Color"
    },
    "activeColor": {
      "type": "color",
      "default": "#7aa2ff",
      "label": "Active color"
    }
  }
}
