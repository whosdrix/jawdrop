---
import type { DotGridOptions } from './core'

type Props = Omit<DotGridOptions, 'root'> & { as?: string; class?: string }
const { as: Tag = 'div', class: className, ...options } = Astro.props
---

<Tag class={className} data-jawdrop="dot-grid" data-options={JSON.stringify(options)}><slot /></Tag>

<script>
  import { dotGrid } from './core'

  for (const el of document.querySelectorAll<HTMLElement>('[data-jawdrop="dot-grid"]')) {
    dotGrid(el, JSON.parse(el.dataset.options ?? '{}'))
  }
</script>
