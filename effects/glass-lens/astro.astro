---
import type { GlassLensOptions } from './core'

type Props = Omit<GlassLensOptions, 'root'> & { as?: string; class?: string }
const { as: Tag = 'div', class: className, ...options } = Astro.props
---

<Tag class={className} data-jawdrop="glass-lens" data-options={JSON.stringify(options)}><slot /></Tag>

<script>
  import { glassLens } from './core'

  for (const el of document.querySelectorAll<HTMLElement>('[data-jawdrop="glass-lens"]')) {
    glassLens(el, JSON.parse(el.dataset.options ?? '{}'))
  }
</script>
