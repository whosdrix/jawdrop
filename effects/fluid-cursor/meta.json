{
  "name": "Fluid cursor",
  "category": "cursor",
  "description": "A real fluid simulation: the cursor pours colored dye that swirls, curls into vortices and fades.",
  "export": "fluidCursor",
  "component": "FluidCursor",
  "budget": 6144,
  "options": {
    "radius": {
      "type": "number",
      "default": 1,
      "min": 0.2,
      "max": 4,
      "step": 0.1,
      "label": "Stream width"
    },
    "force": {
      "type": "number",
      "default": 1,
      "min": 0.1,
      "max": 3,
      "step": 0.1,
      "label": "Force"
    },
    "swirl": { "type": "number", "default": 1, "min": 0, "max": 2, "step": 0.1, "label": "Swirl" },
    "fade": {
      "type": "number",
      "default": 2.5,
      "min": 0.5,
      "max": 8,
      "step": 0.5,
      "label": "Fade (s)"
    },
    "burst": { "type": "boolean", "default": true, "label": "Opening splash" },
    "overlay": { "type": "boolean", "default": false, "label": "Above content" }
  }
}
