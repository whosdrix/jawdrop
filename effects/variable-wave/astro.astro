---
import type { VariableWaveOptions } from './core'

type Props = Omit<VariableWaveOptions, 'root'> & { as?: string; class?: string }
const { as: Tag = 'span', class: className, ...options } = Astro.props
---

<Tag class={className} data-jawdrop="variable-wave" data-options={JSON.stringify(options)}><slot /></Tag>

<script>
  import { variableWave } from './core'

  for (const el of document.querySelectorAll<HTMLElement>('[data-jawdrop="variable-wave"]')) {
    variableWave(el, JSON.parse(el.dataset.options ?? '{}'))
  }
</script>
