---
import type { HorizontalScrollOptions } from './core'

type Props = Omit<HorizontalScrollOptions, 'root'> & { as?: string; class?: string }
const { as: Tag = 'div', class: className, ...options } = Astro.props
---

<Tag class={className} data-jawdrop="horizontal-scroll" data-options={JSON.stringify(options)}><slot /></Tag>

<script>
  import { horizontalScroll } from './core'

  for (const el of document.querySelectorAll<HTMLElement>('[data-jawdrop="horizontal-scroll"]')) {
    horizontalScroll(el, JSON.parse(el.dataset.options ?? '{}'))
  }
</script>
